# transcendence-memory-server multi-embedding configuration
# Copy this to config/profiles.yaml (or set TM_PROFILES_FILE env to your path).
# Without this file, server falls back to legacy EMBEDDING_MODEL/DIM/BASE_URL/API_KEY env (v0.6.x behavior).
#
# Security: api_key_env is **indirection** — yaml never holds the secret value itself.
# Set the actual env var (e.g. GEMINI_API_KEY=sk-...) in docker-compose .env or systemd.

# version 2 新增 llms / vlms 节点与 route 的 llm/vlm/reranker fallback 字段。
# version 1 文件（仅 embedding + reranker）仍兼容 —— 不写新节点即可。
version: 2

# v0.11.0：当客户端只指定 container=X 时，自动 union 到 sibling X_openai 镜像
# （双轨召回，gemini + openai 同时查）。默认 false 保持向后兼容；启用前请确保
# 已通过 clone_container_reembed.py 或 v0.12+ /admin/mirror 创建 sibling。
# 每条请求可用 SearchReq.union: bool 显式覆盖此默认。
union_search_default: false

embeddings:
  # === Common shape: dual-profile so per-container you can pick a fast/cheap
  # embedding for high-volume containers and a higher-quality one for
  # critical ones. All fields below are placeholders — replace `model`,
  # `dim`, `base_url`, `api_key_env` with values that match the channels
  # registered on your gateway. ===

  # Profile A — high-dim option (e.g. 3072 dim for highest semantic recall)
  - name: high-dim-primary
    provider: openai_compatible
    model: <embedding-model-id>             # any embedding model id registered on your gateway
    dim: 3072                               # must equal what the gateway actually returns
    base_url: https://<your-gateway-host>/v1
    api_key_env: PRIMARY_GATEWAY_KEY
    max_token_size: 8192
    request_dim: null                       # null = use model's native dim
    timeout_s: 60
    max_retries: 3

  # Profile B — lower-dim option (e.g. 1024 dim for faster / cheaper / mirror containers)
  # Verify the gateway actually returns the dim you list, since some
  # aggregators normalize embeddings to a fixed dim regardless of the model:
  #   curl POST /v1/embeddings -d '{"model":"<embedding-model-id>","input":"x"}'
  #   python: len(response["data"][0]["embedding"])
  - name: low-dim-secondary
    provider: openai_compatible
    model: <another-embedding-model-id>
    dim: 1024                               # adjust to whatever your gateway returns
    base_url: https://<your-gateway-host>/v1
    api_key_env: PRIMARY_GATEWAY_KEY
    max_token_size: 8192
    timeout_s: 60
    max_retries: 3

  # Optional: a direct provider (not behind aggregator) for orgs with native vendor keys
  - name: direct-provider-fallback
    provider: openai_compatible
    model: <vendor-embedding-model-id>
    dim: 3072
    base_url: https://<vendor-direct-host>/v1
    api_key_env: VENDOR_DIRECT_KEY
    request_dim: 3072                       # explicit dim when the model supports Matryoshka resizing
    timeout_s: 60
    max_retries: 3

  # Optional: gemini_native provider — Google Gemini 原生 :embedContent 协议。
  # 用于原生多模态 embedding（文本 + 图片/PDF/视频/音频 → 统一向量空间），
  # 这是 /embed-multimodal 端点的前置要求；openai_compatible 的 /v1/embeddings
  # 只能处理纯文本，无法做多模态。
  #
  # 关键差异 vs openai_compatible：
  #   - base_url 填 Gemini relay（gemini-balance 等）的「主机根」，
  #     **不带** /v1beta、**不带** /v1。代码自动拼
  #     {base_url}/v1beta/models/{model}:embedContent。
  #   - 鉴权用 x-goog-api-key header（api_key_env 引用的 token）。
  #   - request_dim 非空时透传 output_dimensionality（MRL 维度裁剪）；
  #     缺省 null = 模型原生维度（gemini-embedding-2 为 3072）。
  - name: gemini-embedding-2
    provider: gemini_native
    model: gemini-embedding-2               # body 内自动补成 models/gemini-embedding-2
    dim: 3072                               # 原生多模态统一维度
    base_url: https://<your-gemini-relay-host>   # 主机根，不带 /v1beta
    api_key_env: GEMINI_RELAY_TOKEN         # gemini relay 的 ALLOWED_TOKENS 之一
    max_token_size: 8192
    request_dim: null                       # null = 原生 3072 维
    timeout_s: 120                          # 多模态（视频/音频）单请求偏慢，留足
    max_retries: 3

rerankers:
  # Cohere-style reranker, served via an OpenAI-compatible aggregator gateway
  # (e.g. newapi / one-api / litellm-proxy). The reranker `model` field below
  # depends on what your gateway has registered:
  #
  #   Scenario 1 — your gateway HAS a dedicated reranker channel
  #     (a real cross-encoder service: BGE / Cohere / Jina / Voyage / ...)
  #     Set `model:` to the model id that channel exposes (whatever the
  #     gateway admin registered it as). Verify with:
  #         curl GET  /v1/models               # find channel ids tagged for rerank
  #         curl POST /v1/rerank -d '{"model":"<that-id>","query":"x","documents":["a","b"],"top_n":2}'
  #
  #   Scenario 2 — your gateway has ONLY embedding channels (no dedicated
  #     reranker channel registered)
  #     Set `model:` to any embedding model id from your `embeddings:` list
  #     above. Most aggregators will route /v1/rerank through that channel
  #     and synthesize Cohere-v2 schema via cosine similarity over the
  #     embedded query × documents (pseudo-rerank). Useful as a zero-extra-
  #     dependency starting point. Quality bound: pseudo-rerank reliably
  #     separates "most relevant vs noise" but yields near-uniform scores
  #     for ranks 2..N on small candidate sets, so fine-grained ranking
  #     quality is below a true cross-encoder. See
  #     `docs/operations/rerank-perf-baseline.md`.
  #
  # Anti-pattern: do NOT invent a rerank model id ("text-reranker",
  # "selfhosted-bge" used as a model name, "default-rerank", etc.). Most
  # aggregator gateways reject unknown ids with HTTP 400 model_price_error
  # or 503 model_not_found.
  - name: aggregator-rerank
    provider: cohere_compatible
    model: <reranker-or-embedding-model-id>  # see comment block above for which value to use
    base_url: https://<your-gateway-host>/v1
    api_key_env: PRIMARY_GATEWAY_KEY
    timeout_s: 30
    min_score: 0.0

  # Optional: direct-provider native rerank channel (commercial, byok)
  - name: direct-provider-rerank
    provider: cohere_compatible
    model: <vendor-rerank-model-id>
    base_url: https://<vendor-direct-rerank-host>/v2
    api_key_env: VENDOR_DIRECT_RERANK_KEY
    timeout_s: 30
    min_score: 0.0

# === LLM profiles（version 2 新增）===
# 知识图谱抽取 / 查询用的 chat 模型。与 embedding 不同，LLM 无向量维度锁约束，
# 故 fallback 链可跨任意模型 —— route 的 llm_fallbacks 引用下面任意 name。
# 未提供 llms 节点（或用 version 1 文件）时，服务从 LLM_* env 合成单元素链，
# 行为等价旧版本。provider 默认 openai_compatible（走 /chat/completions）。
llms:
  - name: primary-llm
    provider: openai_compatible
    model: <chat-model-id>                  # 你的网关上注册的 chat 模型 id
    base_url: https://<your-gateway-host>/v1
    api_key_env: PRIMARY_GATEWAY_KEY
    timeout_s: 180                          # 生成类调用比 embedding 慢，留足
    max_retries: 4

  - name: backup-llm
    provider: openai_compatible
    model: <another-chat-model-id>          # 备用链路 —— 不同模型 / 不同网关
    base_url: https://<backup-gateway-host>/v1
    api_key_env: BACKUP_GATEWAY_KEY
    timeout_s: 180
    max_retries: 4

# === VLM profiles（version 2 新增）===
# 视觉 / 多模态生成模型。RAGAnything 的图像转写、/embed-multimodal 的媒体
# caption 生成都走 VLM 链；route 的 vlm_fallbacks 引用下面任意 name。
# 未提供 vlms 节点时，服务从 VLM_* env 合成单元素链。
vlms:
  - name: primary-vlm
    provider: openai_compatible
    model: <vision-chat-model-id>
    base_url: https://<your-gateway-host>/v1
    api_key_env: PRIMARY_GATEWAY_KEY
    timeout_s: 180
    max_retries: 4

  - name: backup-vlm
    provider: openai_compatible
    model: <another-vision-chat-model-id>
    base_url: https://<backup-gateway-host>/v1
    api_key_env: BACKUP_GATEWAY_KEY
    timeout_s: 180
    max_retries: 4

routes:
  # 示例 1: exact match + 各链路 fallback。
  # embedding_fallbacks 必须同 dim（LanceDB 向量维度锁）；llm/vlm/reranker
  # fallback 无此约束，可跨任意模型。每条 *_fallbacks 是「按序尝试」的备用
  # 链：主 profile 不可用（429/5xx/超时）时自动切下一条；4xx 非 429 不切。
  - match: {exact: critical-container-name}
    embedding: high-dim-primary
    embedding_fallbacks: [direct-provider-fallback]  # ⚠ loader enforces dim must match
    reranker: aggregator-rerank
    reranker_fallbacks: [direct-provider-rerank]     # reranker 全挂 → 检索降级为无 rerank
    llm: primary-llm
    llm_fallbacks: [backup-llm]                      # 主 LLM 挂掉 → 知识图谱抽取/查询切备用
    vlm: primary-vlm
    vlm_fallbacks: [backup-vlm]                      # 主 VLM 挂掉 → 图像转写/caption 切备用
    rerank: {enabled: true, chunk_top_k: 30, top_k: 8}

  # 示例 2: glob 匹配某类 container（例如所有"低维镜像"类容器）
  - match: {glob: "*_low_dim_mirror"}
    embedding: low-dim-secondary
    reranker: aggregator-rerank                      # rerank 可用但默认关，per-request `rerank: true` 启用
    rerank: {enabled: false}

  # 示例 3: A/B 测试 reranker 影响：约定一类 container 后缀默认开启 reranker
  # 同 query 在 `foo`（default route, rerank off）和 `foo_rerank_on`（rerank on）
  # 对比 answer 质量 / latency 差异。
  - match: {glob: "*_rerank_on"}
    embedding: high-dim-primary
    reranker: aggregator-rerank
    rerank: {enabled: true, chunk_top_k: 30, top_k: 8}

  # 示例 4: 正则
  - match: {regex: "^v[0-9]+_.*$"}
    embedding: direct-provider-fallback

  # 示例 5: 原生多模态 embedding 容器 — 路由到 gemini_native profile。
  # ⚠ 多模态向量空间与 openai_compatible 文本向量不兼容（即使同 3072 维），
  #   且 LanceDB 表维度首次写入即锁定 —— 必须用**全新独立 container**承接，
  #   不要把 gemini_native route 指到已有文本容器。该容器同时支持：
  #     - POST /embed-multimodal  上传图片/PDF/视频/音频 → 一条向量行
  #     - POST /search            文本 query 经同 profile 算向量后检回
  - match: {exact: ge2-test}
    embedding: gemini-embedding-2

  # 兜底：所有未命中以上的 container 用主 embedding 配置（必须恰好 1 个 default）。
  # llm / vlm 缺省（不写）时退化为 LLM_* / VLM_* env 合成的单元素链。
  - match: {default: true}
    embedding: high-dim-primary
    reranker: aggregator-rerank
    llm: primary-llm
    vlm: primary-vlm
    rerank: {enabled: false}                         # default 不开 rerank，按需 per-call 启用

