# transcendence-memory-server multi-embedding configuration
# Copy this to config/profiles.yaml (or set TM_PROFILES_FILE env to your path).
# Without this file, server falls back to legacy EMBEDDING_MODEL/DIM/BASE_URL/API_KEY env (v0.6.x behavior).
#
# Security: api_key_env is **indirection** — yaml never holds the secret value itself.
# Set the actual env var (e.g. GEMINI_API_KEY=sk-...) in docker-compose .env or systemd.

version: 1

embeddings:
  # === 用户实际场景：双 model 并存 ===

  # Gemini behind an OpenAI-compatible aggregator gateway — 3072 dim
  - name: gemini-3072
    provider: openai_compatible
    model: gemini-embedding-001
    dim: 3072
    base_url: https://<your-aggregator-host>/v1
    api_key_env: GEMINI_API_KEY            # aggregator key with gemini channel access
    max_token_size: 8192
    request_dim: null                       # native 3072
    timeout_s: 60
    max_retries: 3

  # OpenAI text-embedding-3-small behind an aggregator — dim depends on gateway:
  #   - native OpenAI returns 1536; some aggregators normalize to 1024 — verify with
  #     `curl POST /v1/embeddings -d '{"model":"text-embedding-3-small","input":"x"}'`
  #     then `len(response.data[0].embedding)`.
  - name: openai-small-1024
    provider: openai_compatible
    model: text-embedding-3-small
    dim: 1024                              # ⚠ adjust to 1536 if your aggregator returns native OpenAI dim
    base_url: https://<your-aggregator-host>/v1
    api_key_env: AGGREGATOR_API_KEY
    max_token_size: 8192
    timeout_s: 60
    max_retries: 3

  # Native OpenAI for orgs with real OpenAI key — 3072 dim
  - name: openai-large-3072
    provider: openai_compatible
    model: text-embedding-3-large
    dim: 3072
    base_url: https://api.openai.com/v1
    api_key_env: OPENAI_API_KEY
    request_dim: 3072                       # explicit for Matryoshka safety
    timeout_s: 60
    max_retries: 3

rerankers:
  # Cohere-style reranker behind an OpenAI-compatible aggregator gateway
  # (newapi / one-api / litellm-proxy / similar). Two scenarios:
  #
  #   1. Gateway HAS a real reranker channel registered (Cohere / BGE / Jina):
  #      set `model:` to that channel's model id, e.g. `rerank-v3.5`
  #      (Cohere), `bge-reranker-v2-m3` (BGE), `jina-reranker-v2-base`.
  #
  #   2. Gateway has ONLY embedding channels registered (most common with
  #      basic aggregator setups): set `model:` to an embedding model id
  #      such as `text-embedding-3-small`. The gateway will route
  #      /v1/rerank to cosine-similarity-based pseudo-rerank, returning a
  #      valid Cohere-v2 response. Works out-of-the-box without registering
  #      a separate reranker channel. Limitation: pseudo-rerank reliably
  #      separates "most relevant vs noise" but does not produce a true
  #      continuous ranking like a cross-encoder (BGE / Cohere) would.
  #
  # Using a fabricated rerank model id like `text-reranker` will return
  # 400 model_price_error / model_not_found on most aggregator gateways.
  - name: aggregator-rerank
    provider: cohere_compatible
    model: text-embedding-3-small        # pseudo-rerank fallback; swap to real rerank id when available
    base_url: https://<your-aggregator-host>/v1
    api_key_env: AGGREGATOR_API_KEY
    timeout_s: 30
    min_score: 0.0

  # Cohere native (commercial)
  - name: cohere-v3
    provider: cohere_compatible
    model: rerank-v3.5
    base_url: https://api.cohere.com/v2
    api_key_env: COHERE_API_KEY
    timeout_s: 30
    min_score: 0.0

routes:
  # 示例 1: exact match + embedding fallback (same dim required by loader)
  - match: {exact: critical-container-name}
    embedding: gemini-3072
    embedding_fallbacks: [openai-large-3072]     # ⚠ loader enforces dim must match
    reranker: aggregator-rerank
    rerank: {enabled: true, chunk_top_k: 30, top_k: 8}

  # 示例 2: glob 匹配某类 container（如所有 OpenAI 1024 维镜像）
  - match: {glob: "*_openai"}
    embedding: openai-small-1024
    reranker: aggregator-rerank                  # rerank 可用但默认关，per-request `rerank: true` 启用
    rerank: {enabled: false}

  # 示例 3: A/B 测试 reranker 影响：以 _rerank 结尾的 container 默认开启
  # 同 query 在 `foo` (default route, rerank off) 和 `foo_rerank` (rerank on)
  # 对比 answer 质量 / latency 差异。
  - match: {glob: "*_rerank"}
    embedding: gemini-3072
    reranker: aggregator-rerank
    rerank: {enabled: true, chunk_top_k: 30, top_k: 8}

  # 示例 4: 正则
  - match: {regex: "^v[0-9]+_.*$"}
    embedding: openai-large-3072

  # 兜底：所有未命中以上的 container 用 gemini-3072（必须恰好 1 个 default）
  - match: {default: true}
    embedding: gemini-3072
    reranker: aggregator-rerank
    rerank: {enabled: false}                     # default 不开 rerank，按需 per-call 启用
