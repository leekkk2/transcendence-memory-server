# transcendence-memory-server 环境变量模板
# 复制为 .env 并填入实际值：cp .env.example .env

# ╔═══════════════════════════════════════════════════════╗
# ║  必需配置（基础 LanceDB 向量检索）                       ║
# ╚═══════════════════════════════════════════════════════╝

# 服务端 API 认证密钥（客户端通过 X-API-KEY 或 Authorization: Bearer 传入）
RAG_API_KEY=your-rag-api-key

# Embedding 模型配置
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# Embedding 调用重试（对上游 429 / 5xx 友好，可按你的限速容忍度调整）
# 指数退避公式：min(base_delay * 2^attempt, max_delay) ± 25% 抖动；429/5xx 优先尊重 Retry-After
# EMBEDDING_MAX_RETRIES=6
# EMBEDDING_RETRY_BASE_DELAY=1.5
# EMBEDDING_RETRY_MAX_DELAY=60
# EMBEDDING_TIMEOUT=90

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：embedding backlog —— 配额感知静默重试 + 增量索引  ║
# ╚═══════════════════════════════════════════════════════╝
# 记忆是长期沉淀、非实时的：今天写入的内容可能数周 / 数月后才被召回。
# 当 embedding 因上游配额耗尽（free tier 429）/ 超时失败时，失败的对象进
# 持久化 backlog 静默重试（跨天 / 跨周长期重试，不丢失、不报错）；/embed 改
# 增量，只嵌新增 / 变更 / 待重试对象。下列开关默认全开 —— embedding 一切正常
# 时 backlog 恒空、零开销；只有真撞配额 / 超时才走重试分支。**有付费 embedding
# 能力、不撞配额的部署可忽略本节**。容器索引状态经 /containers/{name}/index-status
# 查询。
#
# TM_BACKLOG_ENABLED=1            # 失败对象进 backlog 静默重试（0 = 回退旧行为：失败即丢）
# TM_INCREMENTAL_EMBED=1          # /embed 跳过「已嵌且文本未变」对象（0 = 每次全量重嵌）
# TM_BACKLOG_RETRY_INTERVAL_SEC=300   # worker 扫描到期 backlog 的间隔
# TM_BACKLOG_RETRY_BATCH=50           # 单次定向重试的 chunk 批大小
# TM_BACKLOG_JITTER_PCT=20            # 重试延迟抖动百分比，避免重试洪峰
# 分级退避表（秒，逗号分隔）；下标 = 已重试次数，超出表长停在最后一档无限重复：
# TM_BACKLOG_QUOTA_SCHEDULE=90,300,900,3600,21600,86400   # 配额类（按分钟→按天重置）
# TM_BACKLOG_TIMEOUT_SCHEDULE=30,120,300,900,3600         # 超时类
# TM_BACKLOG_TRANSIENT_SCHEDULE=15,60,180,600,1800        # 瞬时错误类

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：Redis 治理基建 (blueprint P0)                    ║
# ╚═══════════════════════════════════════════════════════╝
# Redis 承载蓝图治理状态：配置热重载、Token 计数、熔断标记。**优雅降级**——
# Redis 不可达时服务照常启动、主 RAG 链路零影响（redis_client 全程吞异常）。
# docker-compose.yml 已内置 redis 服务（默认 host=redis），下面用默认值即可。
# TM_REDIS_ENABLED=0 可整体禁用 Redis 接入（视为永久 down，全走降级路径）。
#
# REDIS_URL=redis://redis:6379/0          # 主连接串；优先级最高，设了就用它
# REDIS_HOST=redis                        # REDIS_URL 缺省时的兜底 host
# REDIS_PORT=6379                         # REDIS_URL 缺省时的兜底 port
# REDIS_PASSWORD=<set-in-deploy-env-if-needed>   # 默认无密码（容器内网隔离）；需要时在部署环境注入
# TM_REDIS_ENABLED=1                      # 0 = 关闭 Redis 接入（永久降级，不建连）

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：配置中心 (blueprint P1) — 热重载 RAG 旋钮         ║
# ╚═══════════════════════════════════════════════════════╝
# 配置中心允许在不重启的情况下持久化/热重载标量 RAG 配置（三层：SQLite→Redis→
# 进程缓存）。两个部署侧旋钮：
#
# HR-9 主机锁：config:model:base_url:* 覆盖只允许指向许可的 LLM 网关主机。下面
# 注入真实网关主机即可启用 host-pin 校验（仅校验 host，不限 scheme/port）。占位
# 默认为 newapi.example（脱敏占位，未注入真实值时仍能跑、仅 host-pin 失配会拒）。
# TM_ALLOWED_MODEL_HOST=newapi.example   # 部署侧注入真实 LLM 网关主机
#
# 敏感配置（config:model:api_keys:*）落库前用 Fernet 加密；不设则明文落库 +
# 一次性告警（私仓威胁模型下可接受）。需要加密时注入一个 Fernet key。
# TM_CONFIG_SECRET=<fernet-key-if-encryption-wanted>

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：启用 LightRAG 知识图谱                           ║
# ║  设置后架构升级为 lancedb+lightrag                      ║
# ╚═══════════════════════════════════════════════════════╝

# 下面这组 LLM_* 在「未提供 config/profiles.yaml」时作为 legacy 兜底仍生效 ——
# 服务会据此合成一个单元素 LLM 链（无 fallback，行为等价旧版本）。
# 配了 profiles.yaml 的 v2 部署应改用 `llms:` 节点 + route 的 `llm_fallbacks`
# 来获得多模型 fallback 链；详见 config/profiles.yaml.example。
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：启用多模态 RAG（PDF/图片/表格解析）                ║
# ║  需同时配置上方 LLM 密钥                                ║
# ║  设置后架构升级为 rag-everything                        ║
# ╚═══════════════════════════════════════════════════════╝

# 同理 VLM_* 在无 profiles.yaml 时作为 legacy 兜底生效（合成单元素 VLM 链）。
# v2 部署应改用 profiles.yaml 的 `vlms:` 节点 + route 的 `vlm_fallbacks`。
VLM_MODEL=qwen3-vl-plus
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=sk-your-api-key

# ╔═══════════════════════════════════════════════════════╗
# ║  服务配置                                              ║
# ╚═══════════════════════════════════════════════════════╝

# 对外 endpoint（connection token 中使用）
RAG_ADVERTISED_ENDPOINT=http://localhost:8711

# 工作区目录（Docker 中默认 /data，本地开发使用项目根目录）
WORKSPACE=/data

# 端口（仅 docker-compose 使用）
TM_PORT=8711

# Docker 镜像（必填，否则 docker compose up 会报 TM_IMAGE required variable not set）。
# 取消下面这行的 # 注释并替换 <your-dockerhub-namespace>，flavor 选 lite 或 full。
# 公共发布的镜像在 https://hub.docker.com/r/example-archive/transcendence-memory-server/tags
# 你也可以 fork 后由自己的 CI 推到自己的 docker hub。
# TM_IMAGE=docker.io/<your-dockerhub-namespace>/transcendence-memory-server:0.6.1-lite

# Docker 构建规格：lite | full
# 默认 lite；如需完整多模态依赖，运行前设为 full
BUILD_TARGET=lite

# ║  可选：Usage Analytics (v0.17)                          ║
# ╚═══════════════════════════════════════════════════════╝
# 服务端为每个 HTTP 请求记录一行 access log（端点 / 状态 / 容器 / 延迟），
# 用于 dashboard Analytics 面板和「端点冷启动 / 调用频次」自检。复用同一
# 个 queue.db（WAL / 单一备份域），数据保留 30 天后由后台 worker 自动清理。
# 中间件零阻塞：每请求只 push 一条 record 进内存队列，由 batcher 异步 flush。
#
# TM_USAGE_ANALYTICS=1            # 主开关，0 = 关闭中间件 + 关闭每日 rollup
# TM_USAGE_RETENTION_DAYS=30      # api_request_log 保留天数（POST /admin/usage/cleanup 使用）
# TM_USAGE_FLUSH_INTERVAL_MS=10   # UsageBatcher flush 间隔
# TM_USAGE_FLUSH_BATCH_SIZE=100   # 单次 flush 最多条数
# TM_USAGE_MAX_BODY_INSPECT=1048576  # 从 body 提取 container 时最多读多少字节
# TM_USAGE_LOG_UA=1               # 0 = 不记录 User-Agent（已截前 80 字符，仍可隐私敏感）
# TM_USAGE_ROLLUP_INTERVAL_SEC=3600  # 后台每日 rollup 触发间隔

# ╔═══════════════════════════════════════════════════════╗
# ║  可选：Admin Dashboard (`/admin/ui/`) — v0.17           ║
# ╚═══════════════════════════════════════════════════════╝
# 内嵌的可视化管理后台。鉴权复用 RAG_API_KEY —— 登录后服务端发放一个
# HttpOnly + Secure + SameSite=Strict 的 cookie (`tm_sid`)，前端不再持有
# 明文 key。SessionStore + LoginRateLimit 共用一份 sqlite (`tasks/rag/ui_sessions.db`)。
#
# TM_UI_ENABLED=1                # 主开关；0 = 不挂 /admin/ui 静态资源（API 路由仍在）
# TM_UI_SESSION_TTL=7200         # 单个 cookie 会话有效秒数（默认 2h）
# TM_UI_LOGIN_LOCKOUT_COUNT=5    # 触发 lockout 的连续失败次数
# TM_UI_LOGIN_LOCKOUT_WINDOW=900 # lockout 滑窗（秒，默认 15 分钟）
# TM_UI_CORS_ALLOW_ORIGIN=       # 仅本地开发用；prod 留空 = 关 CORS
# TM_ENV=prod                    # topbar 角标颜色：prod 红 / staging 黄 / dev 绿

# --- Governance agent orchestration (opt-in, default OFF) ---
# 治理编排 Agent：网关 LLM 的 tool-use 循环，规划调用治理工具箱、留痕、破坏性
# 操作进人工审批队列。总闸默认关闭（不入队、不影响默认部署）。LLM 路由复用上方
# LLM_MODEL / LLM_BASE_URL / LLM_API_KEY（经 rag_engine 网关，不新增 model env）。
# TM_AGENT_ORCHESTRATION_ENABLED=0   # 主开关，0 = 关闭（默认）；1 = 允许 /admin/agent 入队
# TM_AGENT_MAX_STEPS=6               # 单次运行最大步数（硬上限，over-budget 出局）
# TM_AGENT_RUN_TIMEOUT_SEC=300       # 单次运行墙钟上限（秒），超时产出部分报告
# TM_AGENT_DAILY_TOKEN_BUDGET=       # 每日 token 预算上限，留空 = 不额外限制
# TM_COMPRESS_BATCH_BYTES=           # 知识聚类压缩单批字节预算（留空 = 默认 8 MiB）
