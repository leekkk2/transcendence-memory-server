# systemd unit for the transcendence-memory-server docker compose stack.
#
# Install:
#   sudo cp deploy/systemd/rag-everything.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rag-everything.service
#
# Reload (after `git pull` of a new tag in WorkingDirectory):
#   sudo systemctl reload rag-everything
#
# This unit replaces the legacy ExecStart=run_task_rag_server.sh design that
# looped on 203/EXEC for ~520k restarts before it was found. The current
# unit treats Docker as the runtime; systemd only ensures the compose stack
# is up at boot and provides a clean stop/reload surface.

[Unit]
Description=transcendence-memory-server (docker compose stack)
Documentation=https://github.com/leekkk2/transcendence-memory-server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Optional: if your host bind-mounts an rclone (or other FUSE) archive into the
# container, declare the host mount here so systemd waits for it before starting.
# Otherwise in-container reads to that path can block in D-state when FUSE is slow.
# Add via drop-in (recommended): /etc/systemd/system/rag-everything.service.d/rclone.conf
#   [Unit]
#   RequiresMountsFor=/mnt/your-rclone-mount

[Service]
Type=oneshot
RemainAfterExit=yes
# Default: install the repo at /opt/transcendence-memory-server. If you cloned
# elsewhere, override via drop-in (set WorkingDirectory and optionally User).
WorkingDirectory=/opt/transcendence-memory-server
ExecStart=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose pull
ExecReload=/usr/bin/docker compose up -d
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
