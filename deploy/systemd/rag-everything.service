# systemd unit for the transcendence-memory-server docker compose stack.
#
# Install:
#   sudo cp deploy/systemd/rag-everything.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rag-everything.service
#
# Reload (after `git pull` of a new tag in WorkingDirectory):
#   sudo systemctl reload rag-everything
#
# This unit replaces the legacy ExecStart=run_task_rag_server.sh design that
# looped on 203/EXEC for ~520k restarts before it was found. The current
# unit treats Docker as the runtime; systemd only ensures the compose stack
# is up at boot and provides a clean stop/reload surface.

[Unit]
Description=transcendence-memory-server (docker compose stack)
Documentation=https://github.com/leekkk2/transcendence-memory-server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# rclone FUSE mount must be live before container starts — otherwise in-container
# reads to /mnt/rclone/* block in D-state. Adjust the path for hosts that don't
# bind-mount rclone.
RequiresMountsFor=/mnt/rclone/example-archive

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
WorkingDirectory=/home/user/.appdir/workspace/gitlab/transcendence-memory-server
ExecStart=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose pull
ExecReload=/usr/bin/docker compose up -d
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
